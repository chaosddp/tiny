{
    "$schema": ".vscode/emmylua.schema.json",
    "workspace": {
        "ignoreDir": [
            "target",
            "tests"
        ],
        "library": [
            "tiny/typings"
        ],
        "workspaceRoots": ["."]
    },
    "completion": {
        "autoRequire": true,
        "callSnippet": false,
        "postfix": "@"
    },
    "diagnostics": {
        "globals": [],
        "disable": []
    },
    "doc": {
        "syntax": "md"
    },
    "runtime": {
        "version": "Lua5.5",
        "requirePattern": [
            "?.lua",
            "?/init.lua"
        ]
    }
}